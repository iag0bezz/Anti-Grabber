<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versão do Windows explícita (não só "net8.0-windows") — sem isso o NuGet
         resolve o asset genérico do Microsoft.Toolkit.Uwp.Notifications, que não
         inclui a interop WinRT de toast (ToastNotificationActivatedEventArgsCompat
         etc. somem). 17763 = Windows 10 1809, baseline seguro. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>..\tray-ui\assets\app.ico</ApplicationIcon>
    <AssemblyName>AntiGrabber.Tray</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiGrabber.Shared\AntiGrabber.Shared.csproj" />
  </ItemGroup>

</Project>
